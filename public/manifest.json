{
  "manifest_version": 3,
  "name": "Live Network Data Collector",
  "description": "Capture permitted JSON API responses from a user-selected tab and export accumulated datasets locally.",
  "version": "0.1.0",
  "minimum_chrome_version": "118",
  "permissions": [
    "debugger",
    "tabs",
    "storage",
    "sidePanel",
    "downloads",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "*://go.bandahealth.org/*",
    "https://*/*",
    "http://*/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Live Network Data Collector Dashboard",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
